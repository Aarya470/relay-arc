# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the ER dispatch board, push fan-out and /admin.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (server-side only — never expose to the browser) ─────────────────────
GROQ_API_KEY=

# ── Push notifications (npx web-push generate-vapid-keys) ──────────────────
NEXT_PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Portals ─────────────────────────────────────────────────────────────────
# Unlocks /admin (facility onboarding, code rotation, audit trail).
ADMIN_PORTAL_KEY=
# Unlocks the care-team portal.
CARE_TEAM_ACCESS_CODE=

# ── Optional: live traffic. Without it, a time-of-day model is used and the
# UI labels ETAs "estimated" instead of "live traffic".
NEXT_PUBLIC_TOMTOM_KEY=

# ── Optional: protects Vercel cron endpoints ───────────────────────────────
CRON_SECRET=
